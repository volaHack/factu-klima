# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# nombre reservado de Windows: git no puede indexarlo y aborta el `add`
nul

# binarios de escritorio: GitHub rechaza el push por encima de 100 MB.
# Los instaladores se publican aparte (Releases / almacenamiento de objetos),
# no dentro del repositorio.
electron/dist/
electron/.electron-cache/
public/descargas/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
